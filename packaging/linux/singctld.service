# singctld.service — system-wide singctl proxy/VPN daemon (Linux).
#
# Reference template. scripts/install-linux.sh generates the real unit at
# /etc/systemd/system/singctld.service, substituting @BIN@/@USER@/@HOME@ for the
# installed binary path and the installing user's home (the daemon runs as root
# for the TUN device + cgroup/nftables per-app routing, but must use that user's
# ~/.config/singctl — same dir `sudo singctl` uses — so a client can attach).
#
# Manage:  systemctl {status,start,stop,restart} singctld
#          journalctl -u singctld -f
[Unit]
Description=singctl proxy/VPN daemon
Documentation=man:singctl(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: TUN device, route + cgroup/nftables management.
User=root
# Pin the daemon to the installing user's config dir (instance.json, profile,
# control socket, log) so `singctl --attach/--status/--stop` and the GUI can
# find it. The key is loaded from the saved profile, never the command line.
Environment=SUDO_USER=@USER@
Environment=HOME=@HOME@
ExecStart=@BIN@ --headless --vpn
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
