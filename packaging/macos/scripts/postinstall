#!/bin/bash
#
# pkg postinstall — installs the singctl boot-start LaunchDaemon after the .pkg
# lays down the CLI (/usr/local/bin/singctl) and the GUI (/Applications/Singctl.app,
# the native SwiftUI app that also hosts the embedded ProxyExtension system
# extension — there is no longer a separate SingctlProxy.app).
# Runs as root. The daemon is pinned to the logged-in (console) user's
# ~/.config/singctl so it matches what the per-user GUI reads.
set -e

LABEL="com.singctl.proxy"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
BIN="/usr/local/bin/singctl"

# Resolve the real desktop user (pkg installers run as root).
REAL_USER="$(stat -f "%Su" /dev/console 2>/dev/null || echo root)"
if [ "$REAL_USER" = "root" ] || [ -z "$REAL_USER" ]; then
	REAL_HOME="/var/root"
else
	REAL_HOME="$(dscl . -read "/Users/${REAL_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
	[ -n "$REAL_HOME" ] || REAL_HOME="/Users/${REAL_USER}"
fi

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${BIN}</string>
        <string>--headless</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SUDO_USER</key>
        <string>${REAL_USER}</string>
        <key>HOME</key>
        <string>${REAL_HOME}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/var/log/singctl.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/singctl.log</string>
</dict>
</plist>
PLIST
chown root:wheel "$PLIST"

# (Re)load it. KeepAlive=true keeps the daemon available after installation.
launchctl bootout system "$PLIST" 2>/dev/null || true
launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null || true

# Verify the daemon actually came up instead of assuming bootstrap succeeded.
# Poll briefly (bounded, a few seconds) for either launchd reporting the job
# loaded or the control socket appearing under the real user's
# ~/.config/singctl. This is diagnostic only: the payload is installed
# correctly either way, and the GUI has its own "start the daemon" path, so
# failing the whole .pkg install here would be worse than just reporting it.
SOCK_PATH="${REAL_HOME}/.config/singctl/control.sock"
DAEMON_UP=0
for _ in 1 2 3 4 5 6; do
	if launchctl print "system/${LABEL}" >/dev/null 2>&1; then
		DAEMON_UP=1
		break
	fi
	if [ -S "$SOCK_PATH" ]; then
		DAEMON_UP=1
		break
	fi
	sleep 1
done
if [ "$DAEMON_UP" = "1" ]; then
	echo "==> ${LABEL} is up"
else
	echo "==> WARNING: ${LABEL} did not come up within the poll window (checked launchctl print system/${LABEL} and ${SOCK_PATH}); the app installed correctly — start the daemon from the GUI or run 'sudo launchctl kickstart -k system/${LABEL}'"
fi

# Launch the GUI once in the console user's session so macOS surfaces the
# "Allow Network Extension" prompt right away instead of the user having to
# discover and open the app themselves. This is best-effort:
# OSSystemExtensionManager activation still requires the user to *manually
# approve* the extension afterwards in System Settings → General → Login
# Items & Extensions → Network Extensions.
if [ -d /Applications/Singctl.app ] && [ -n "$REAL_USER" ] && [ "$REAL_USER" != "root" ]; then
	CONSOLE_UID="$(stat -f "%u" /dev/console 2>/dev/null || echo "")"
	if [ -n "$CONSOLE_UID" ]; then
		launchctl asuser "$CONSOLE_UID" sudo -u "$REAL_USER" open -a /Applications/Singctl.app 2>/dev/null || true
	fi
fi

exit 0
