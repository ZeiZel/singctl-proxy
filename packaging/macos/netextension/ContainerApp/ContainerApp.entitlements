<?xml version="1.0" encoding="UTF-8"?>
<!-- Container app entitlements. Needs the same Network Extensions capability to
     manage NETransparentProxyManager, the App Group for the shared config.json,
     and the App Sandbox (required for system-extension distribution). SCAFFOLD:
     replace identifiers with your provisioned ones. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>app-proxy-provider-systemextension</string>
    </array>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.singctl.proxy</string>
    </array>
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
