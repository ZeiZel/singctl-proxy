# Copy to .env and fill in real values, then `docker compose up -d`.
# NEVER commit the real .env — it holds the license-signing private key and
# the admin bearer token. (Root .gitignore already excludes deploy/compose/.env.)

# Server image to deploy. In CI this is set to $CI_REGISTRY_IMAGE / $CI_COMMIT_SHA.
IMAGE=registry.gitlab.com/GROUP/singctl-proxy
TAG=latest

# Public domain for automatic HTTPS via Caddy, e.g. license.example.com.
# Leave empty (or set ":80") to serve plain HTTP on :80 — the compose file maps
# an empty value to ":80" for you (an empty value passed straight to Caddy would
# crash it). Use a real domain to get automatic Let's Encrypt HTTPS.
LICENSE_SITE_ADDRESS=

# Base64 Ed25519 private key for signing licenses — generate with:
#   docker run --rm --entrypoint /server $IMAGE keygen
# Keep the private key on the server only; the matching public key goes into
# CLI builds (LICENSE_PUBKEY), never here.
LICENSE_PRIVATE_KEY=

# Bearer token for the /v1/admin/* endpoints — generate with:
#   openssl rand -hex 32
LICENSE_ADMIN_TOKEN=

# HMAC secret for POST /v1/webhook/payment. Leave empty to disable the webhook.
LICENSE_WEBHOOK_SECRET=

# Default license validity, in days. 0 = perpetual.
LICENSE_DEFAULT_TTL_DAYS=0
