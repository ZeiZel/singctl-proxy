<?xml version="1.0" encoding="UTF-8"?>
<!-- App/Info.plist — the Singctl.app that hosts and activates the
     ProxyExtension system extension. Unlike the old ContainerApp scaffold,
     this is a regular windowed app (NOT LSUIElement): it has a normal
     window AND a MenuBarExtra menu-bar item. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.singctl.proxy</string>
    <key>CFBundleName</key>
    <string>Singctl</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSystemExtensionUsageDescription</key>
    <string>Singctl installs a network-extension system extension to transparently proxy selected apps' traffic through singctl's local SOCKS proxy.</string>
</dict>
</plist>
