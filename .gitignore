/bin
/dist
/.DS_store


# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Compose deployment secrets (private key, admin token, webhook secret)
deploy/compose/.env

# macOS Singctl app build artifacts (xcodegen output + Xcode DerivedData)
/macos/Singctl/build/
/macos/Singctl/build_check/
/macos/Singctl/Singctl.xcodeproj/
/singctl
/server

# gomobile-built sing-box core (reproduce with `make libbox`; ~68MB, not committed)
macos/Singctl/Libbox.xcframework/

# Issued license tokens (secrets) — never commit
licenses/

# Local env with secrets — never commit
.env

# Personal system-proxy rules; use packaging/macos/singctl-proxy-rules.example.ini
# as the checked-in template.
packaging/macos/singctl-proxy-rules.ini
